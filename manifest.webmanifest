{
  "id": "./",
  "name": "Waypoint Planner",
  "short_name": "Waypoint",
  "description": "Plan trips day by day on a live map, with hotels, bookings, budget and packing in one place.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E9EEEC",
  "theme_color": "#0E6E66",
  "categories": ["travel", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Itinerary", "url": "./?view=plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bookings", "url": "./?view=bookings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved places", "url": "./?view=saved", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
